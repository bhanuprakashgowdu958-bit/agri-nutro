# ==============================================================================
# NutriAgro Feeds (India) - Local & Cloud Environment Configuration
# ==============================================================================
#
# 1. Google Gemini AI API Key (Optional)
#    Get your free API key at: https://aistudio.google.com/
#
#    - If provided: Dr. Thorne uses live Google Gemini Generative AI for real-time questions.
#    - If left blank: Dr. Thorne automatically runs in offline/built-in mode using NutriAgro's
#      complete scientific agronomy & commercial animal nutrition database (zero errors).
#
GEMINI_API_KEY=

# 2. Local Dev Server Port (Default: 8080)
PORT=8080

# 3. Google Cloud OAuth 2.0 Client ID (Optional)
#    Get your Client ID at: https://console.cloud.google.com/apis/credentials
#    Enables Google Identity Services live native popup & multi-account chooser.
GOOGLE_CLIENT_ID=
